---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import Search from '../components/Search.astro';
import { REPO_URL } from '../lib/labels';

interface Props {
  /** Page title; omit on the home page */
  title?: string;
  description?: string;
  /** Social preview image (site-relative path) */
  image?: string;
  /** Set on entry pages so link previews say "article" rather than "website". */
  type?: 'website' | 'article';
  publishedTime?: Date;
}

const {
  title,
  description = 'The AI Encyclopedia: a growing collection of time-tested papers, software, interviews, positions, demos, and blogs worth knowing on the way into the singularity, each explained with an interactive demo.',
  image,
  type = 'website',
  publishedTime,
} = Astro.props;

const fullTitle = title ? `${title} | AIpedia` : 'AIpedia — The AI Encyclopedia';
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const imageUrl = image ? new URL(image, Astro.site ?? Astro.url.origin).href : undefined;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="AIpedia" href="/rss.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="AIpedia" />
    <meta property="og:title" content={title ?? fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title ?? fullTitle} />
    <meta name="twitter:description" content={description} />
    <slot name="head" />

    <script is:inline>
      const theme = localStorage.getItem('theme') ||
        (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.classList.toggle('dark', theme === 'dark');

      // The logo compresses "The AI Encyclopedia" on every page load
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('logo-intro');
      }
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main" class="skip-link">Skip to content</a>

    <header class="sticky top-0 z-50 bg-bg/80 backdrop-blur-md border-b border-border">
      <nav class="max-w-7xl mx-auto px-5 h-12 flex items-center justify-between">
        <Logo />
        {/* On phones the logo intro needs the whole bar, so the links fade in after it */}
        <div class="flex items-center gap-5 transition-opacity duration-500 delay-300 max-sm:[.logo-intro_&]:opacity-0">
          <button
            type="button"
            data-search-open
            class="inline-flex items-center gap-2 text-text-secondary hover:text-text text-[13px] transition-colors"
            aria-label="Search entries"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <kbd class="hidden sm:inline font-mono text-[10.5px] leading-4 px-1 rounded border border-border">⌘K</kbd>
          </button>
          <a
            href="/tags"
            class:list={[
              'text-[13px] transition-colors hover:text-text',
              path.startsWith('/tags') ? 'text-text' : 'text-text-secondary',
            ]}
            aria-current={path.startsWith('/tags') ? 'page' : undefined}
          >
            Topics
          </a>
          <a
            href={`${REPO_URL}/blob/main/CONTRIBUTING.md`}
            target="_blank"
            rel="noopener noreferrer"
            class="hidden sm:inline text-text-secondary hover:text-text text-[13px] transition-colors"
          >
            Contribute
          </a>
          <a
            href={REPO_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="text-text-secondary hover:text-text transition-colors"
            aria-label="AIpedia on GitHub"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
          </a>
          <button
            id="theme-toggle"
            class="text-text-secondary hover:text-text transition-colors"
            aria-label="Toggle dark mode"
          >
            <svg class="w-4 h-4 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
            <svg class="w-4 h-4 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
            </svg>
          </button>
        </div>
      </nav>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-border py-10 mt-24">
      <div class="max-w-7xl mx-auto px-5 flex flex-col items-center gap-3 text-center text-text-secondary text-xs tracking-wide">
        <div class="flex flex-col items-center gap-1.5">
          <a href="/" class="tracking-tight"><span class="font-semibold text-text">AI</span><span>pedia</span></a>
          <p>The AI Encyclopedia</p>
        </div>
        <p class="flex flex-wrap justify-center gap-x-4 gap-y-1">
          <a href="/tags" class="hover:text-text transition-colors">Topics</a>
          <a href="/rss.xml" class="hover:text-text transition-colors">RSS</a>
          <a href="/llms.txt" class="hover:text-text transition-colors">llms.txt</a>
          <a href={REPO_URL} target="_blank" rel="noopener noreferrer" class="hover:text-text transition-colors">GitHub</a>
        </p>
      </div>
    </footer>

    <dialog
      id="search-dialog"
      aria-label="Search entries"
      class="w-[min(36rem,calc(100vw-2rem))] p-5 rounded-2xl bg-bg text-text border border-border shadow-2xl backdrop:bg-black/50 backdrop:backdrop-blur-sm"
    >
      <Search variant="dialog" />
      <p class="mt-4 text-xs text-text-secondary flex items-center gap-3">
        <span>↑↓ to navigate</span>
        <span>↵ to open</span>
        <span>esc to close</span>
      </p>
    </dialog>

    <script>
      import '../scripts/search';

      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      });
    </script>

    <style>
      #search-dialog {
        margin-inline: auto;
        margin-top: 12vh;
      }
      #search-dialog[open] {
        animation: search-in 120ms ease-out;
      }
      @keyframes search-in {
        from {
          opacity: 0;
          transform: translateY(-6px);
        }
      }
    </style>
  </body>
</html>
