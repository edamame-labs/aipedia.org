---
import type { MarkdownHeading } from 'astro';
import Base from './Base.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { ArrowUpRight, EntryCard, Thumbnail } from '../components/EntryCard';
import {
  CATEGORY_LABELS,
  REPO_URL,
  RESOURCE_LABELS,
  quickLinks,
  sourceLabel,
  tagLabel,
  type Item,
} from '../lib/labels';
import { askAILinks, siteOrigin } from '../lib/markdown';

interface Props {
  item: Item;
  headings: MarkdownHeading[];
  related: Item[];
}

const { item, headings, related } = Astro.props;
const category = CATEGORY_LABELS[item.category];
const sections = headings.filter(({ depth }) => depth === 2);
const demo = sections.find(({ text }) => /^interactive/i.test(text));
const editUrl = `${REPO_URL}/edit/main/src/content/wiki/${item.slug}.mdx`;
const markdownPath = `/${item.slug}.md`;
const askLinks = askAILinks(
  `Read ${siteOrigin(Astro.site)}${markdownPath}. It's the AIpedia entry on "${item.title}". Explain it to me: ` +
    'start with the intuition, then go deeper, and point me to the best of its resources.'
);
---

<Base
  title={item.title}
  description={item.description}
  image={item.thumb}
  type="article"
  publishedTime={item.added ? new Date(item.added) : undefined}
>
  <link slot="head" rel="alternate" type="text/markdown" href={markdownPath} />

  <div class="max-w-7xl mx-auto px-5 pt-10">
    <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_272px] lg:gap-14 xl:gap-20">
      <article class="min-w-0 max-w-3xl">
        <nav aria-label="Breadcrumb" class="text-[13px] text-text-secondary">
          <a href="/" class="hover:text-text transition-colors">Index</a>
          <span class="mx-1.5 text-border">/</span>
          <a href={`/?type=${item.category}`} class="hover:text-text transition-colors">{category.many}</a>
        </nav>

        <header class="mt-5 mb-10">
          <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight leading-tight text-balance">{item.title}</h1>
          <p class="mt-3 text-[17px] text-text-secondary leading-relaxed">{item.description}</p>

          <div class="lg:hidden mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 text-[13px]">
            <span class="font-mono text-[11px] uppercase tracking-[0.08em] text-text-secondary">
              {[category.one, item.year].filter(Boolean).join(' · ')}
            </span>
            {quickLinks(item.resources).map((resource) => (
              <a
                href={resource.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-0.5 text-text-secondary hover:text-text transition-colors"
              >
                {RESOURCE_LABELS[resource.kind]}<ArrowUpRight />
              </a>
            ))}
            {demo && (
              <a href={`#${demo.slug}`} class="text-text-secondary hover:text-text transition-colors">Demo &darr;</a>
            )}
          </div>
        </header>

        <TableOfContents headings={headings} variant="mobile" />

        <div class="prose max-w-none">
          <slot />
        </div>
      </article>

      <aside class="mt-16 lg:mt-0" aria-label="About this entry">
        <div class="rounded-xl border border-border overflow-hidden">
          {item.thumb && demo && (
            <a href={`#${demo.slug}`} class="group block border-b border-border bg-bg-secondary">
              <Thumbnail item={item} />
              <span class="flex items-center justify-between px-4 py-2 font-mono text-[11px] uppercase tracking-[0.08em] text-text-secondary group-hover:text-text transition-colors">
                Interactive demo <span aria-hidden="true">&darr;</span>
              </span>
            </a>
          )}
          <dl class="divide-y divide-border text-[13px]">
            <div class="grid grid-cols-[4.5rem_1fr] gap-3 px-4 py-2.5">
              <dt class="text-text-secondary">Type</dt>
              <dd><a href={`/?type=${item.category}`} class="hover:underline underline-offset-4">{category.one}</a></dd>
            </div>
            {item.by && (
              <div class="grid grid-cols-[4.5rem_1fr] gap-3 px-4 py-2.5">
                <dt class="text-text-secondary">By</dt>
                <dd>{item.by}</dd>
              </div>
            )}
            {item.year && (
              <div class="grid grid-cols-[4.5rem_1fr] gap-3 px-4 py-2.5">
                <dt class="text-text-secondary">Year</dt>
                <dd class="font-mono tabular-nums">{item.year}</dd>
              </div>
            )}
            {item.tags.length > 0 && (
              <div class="grid grid-cols-[4.5rem_1fr] gap-3 px-4 py-2.5">
                <dt class="text-text-secondary">Topics</dt>
                <dd class="leading-relaxed">
                  {item.tags.map((tag, i) => (
                    <>
                      <a href={`/tags/${tag}`} class="hover:underline underline-offset-4">{tagLabel(tag)}</a>{i < item.tags.length - 1 && ', '}
                    </>
                  ))}
                </dd>
              </div>
            )}
            <div class="grid grid-cols-[4.5rem_1fr] gap-3 px-4 py-2.5">
              <dt class="text-text-secondary">Reading</dt>
              <dd>{item.minutes} min</dd>
            </div>
          </dl>
        </div>

        {item.resources.length > 0 && (
          <section class="mt-8">
            <h2 class="font-mono text-[11px] uppercase tracking-[0.08em] text-text-secondary">Resources</h2>
            <ul class="mt-3 space-y-4">
              {item.resources.map((resource) => (
                <li>
                  <a href={resource.url} target="_blank" rel="noopener noreferrer" class="group block">
                    <span class="font-mono text-[10.5px] uppercase tracking-[0.08em] text-text-secondary">
                      {RESOURCE_LABELS[resource.kind]} · {sourceLabel(resource.url)}
                    </span>
                    <span class="mt-0.5 block text-[13.5px] leading-snug underline-offset-4 group-hover:underline">
                      {resource.title}<ArrowUpRight className="ml-0.5 inline h-3 w-3 text-text-secondary" />
                    </span>
                    {resource.note && <span class="mt-0.5 block text-[12.5px] text-text-secondary">{resource.note}</span>}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        <section class="mt-8" aria-labelledby="for-ai">
          <h2 id="for-ai" class="font-mono text-[11px] uppercase tracking-[0.08em] text-text-secondary">For your AI</h2>
          <p class="mt-3 flex flex-wrap gap-x-4 gap-y-1.5 text-[13px] text-text-secondary">
            <button type="button" data-copy-markdown={markdownPath} class="hover:text-text transition-colors">
              Copy as Markdown
            </button>
            {askLinks.map(({ label, href }) => (
              <a
                href={href}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-0.5 hover:text-text transition-colors"
              >
                {label}<ArrowUpRight />
              </a>
            ))}
          </p>
        </section>

        <TableOfContents headings={headings} variant="desktop" />
      </aside>
    </div>

    {related.length > 0 && (
      <section class="mt-20 pt-10 border-t border-border" aria-labelledby="related">
        <h2 id="related" class="font-mono text-[11px] uppercase tracking-[0.08em] text-text-secondary mb-5">Related</h2>
        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((entry) => <EntryCard item={entry} />)}
        </div>
      </section>
    )}

    <p class="mt-10 text-[13px]">
      <a href={editUrl} target="_blank" rel="noopener noreferrer" class="text-text-secondary hover:text-text transition-colors">
        Edit this page on GitHub &rarr;
      </a>
    </p>
  </div>
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-markdown]').forEach((button) => {
    const label = button.textContent;
    button.addEventListener('click', async () => {
      try {
        const response = await fetch(button.dataset.copyMarkdown!);
        await navigator.clipboard.writeText(await response.text());
        button.textContent = 'Copied';
      } catch {
        button.textContent = 'Copy failed';
      }
      setTimeout(() => (button.textContent = label), 1600);
    });
  });

</script>
