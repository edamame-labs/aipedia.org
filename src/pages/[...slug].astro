---
import WikiPage from '../layouts/WikiPage.astro';
import { getEntries, getItems, relatedItems, toItem, type Entry } from '../lib/catalog';

export async function getStaticPaths() {
  const entries = await getEntries();
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: Entry };
const { Content, headings } = await entry.render();
const item = toItem(entry);
const related = relatedItems(item, await getItems());
---

<WikiPage item={item} headings={headings} related={related}>
  <Content />
</WikiPage>
