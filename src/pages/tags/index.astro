---
import Base from '../../layouts/Base.astro';
import { getItems, topicCounts } from '../../lib/catalog';
import { tagLabel } from '../../lib/labels';

const items = await getItems();
const topics = topicCounts(items, { includeBroad: true });
---

<Base title="Topics" description="Browse AIpedia entries by topic.">
  <div class="max-w-7xl mx-auto px-5 pt-10">
    <nav aria-label="Breadcrumb" class="text-[13px] text-text-secondary">
      <a href="/" class="hover:text-text transition-colors">Index</a>
    </nav>
    <h1 class="mt-5 text-3xl sm:text-4xl font-semibold tracking-tight">Topics</h1>
    <p class="mt-3 text-text-secondary">{topics.length} topics across {items.length} entries.</p>

    <div class="mt-10 flex flex-wrap gap-1.5">
      {topics.map(({ tag, count }) => (
        <a
          href={`/tags/${tag}`}
          class="flex items-center gap-1.5 px-2.5 py-1 rounded-md border border-border text-text-secondary hover:text-text hover:border-text/20 transition-colors"
        >
          <span class="text-[13px]">{tagLabel(tag)}</span>
          <span class="font-mono text-[11px] tabular-nums opacity-60">{count}</span>
        </a>
      ))}
    </div>
  </div>
</Base>
