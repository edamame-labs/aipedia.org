---
import Base from '../../layouts/Base.astro';
import { getItems, topicCounts } from '../../lib/catalog';
import { tagLabel } from '../../lib/labels';

const items = await getItems();
const topics = topicCounts(items, { includeBroad: true });

// Most tags are used exactly once. Splitting them out keeps the index from
// reading as one undifferentiated cloud.
const shared = topics.filter(({ count }) => count > 1);
const singleUse = topics
  .filter(({ count }) => count === 1)
  .sort((a, b) => tagLabel(a.tag).localeCompare(tagLabel(b.tag)));
---

<Base title="Topics" description="Browse AIpedia entries by topic.">
  <div class="max-w-7xl mx-auto px-5 pt-10">
    <nav aria-label="Breadcrumb" class="text-[13px] text-text-secondary">
      <a href="/" class="hover:text-text transition-colors">Index</a>
    </nav>
    <h1 class="mt-5 text-3xl sm:text-4xl font-semibold tracking-tight">Topics</h1>
    <p class="mt-3 text-text-secondary">{topics.length} topics across {items.length} entries.</p>

    <section class="mt-10" aria-labelledby="shared-topics">
      <h2 id="shared-topics" class="mb-4 font-mono text-[11px] uppercase tracking-[0.08em] text-text-secondary">
        Shared across entries
      </h2>
      <ul class="flex flex-wrap gap-1.5">
        {shared.map(({ tag, count }) => (
          <li>
            <a
              href={`/tags/${tag}`}
              class="flex items-center gap-1.5 px-2.5 py-1 rounded-md border border-border text-text-secondary hover:text-text hover:border-border-strong transition-colors"
            >
              <span class="text-[13px]">{tagLabel(tag)}</span>
              <span class="font-mono text-[11px] tabular-nums opacity-60">{count}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-12" aria-labelledby="single-topics">
      <h2 id="single-topics" class="mb-4 font-mono text-[11px] uppercase tracking-[0.08em] text-text-secondary">
        Used by a single entry
      </h2>
      <ul class="flex flex-wrap gap-x-4 gap-y-2 text-[13px]">
        {singleUse.map(({ tag }) => (
          <li>
            <a href={`/tags/${tag}`} class="text-text-secondary hover:text-text transition-colors">{tagLabel(tag)}</a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Base>
