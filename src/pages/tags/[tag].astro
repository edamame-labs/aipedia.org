---
import Base from '../../layouts/Base.astro';
import { EntryCard } from '../../components/EntryCard';
import { getItems } from '../../lib/catalog';
import { tagLabel, type Item } from '../../lib/labels';

export async function getStaticPaths() {
  const items = await getItems();
  const tags = [...new Set(items.flatMap((item) => item.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: { tag, items: items.filter((item) => item.tags.includes(tag)) },
  }));
}

const { tag, items } = Astro.props as { tag: string; items: Item[] };
const label = tagLabel(tag);
---

<Base title={label} description={`AIpedia entries about ${label}.`}>
  <div class="max-w-7xl mx-auto px-5 pt-10">
    <nav aria-label="Breadcrumb" class="text-[13px] text-text-secondary">
      <a href="/" class="hover:text-text transition-colors">Index</a>
      <span class="mx-1.5 text-border">/</span>
      <a href="/tags" class="hover:text-text transition-colors">Topics</a>
    </nav>
    <h1 class="mt-5 text-3xl sm:text-4xl font-semibold tracking-tight">{label}</h1>
    <p class="mt-3 text-text-secondary">
      {items.length} {items.length === 1 ? 'entry' : 'entries'}
      <span class="mx-1.5 text-border">/</span>
      <a href={`/?topic=${tag}`} class="hover:text-text transition-colors">Filter in the index &rarr;</a>
    </p>

    <div class="mt-10 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {items.map((item) => <EntryCard item={item} />)}
    </div>
  </div>
</Base>
