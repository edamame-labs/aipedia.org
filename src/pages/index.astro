---
import Base from '../layouts/Base.astro';
import { ArrowUpRight } from '../components/EntryCard';
import { EntryIndex } from '../components/EntryIndex';
import { getItems, topicCounts, START_HERE } from '../lib/catalog';
import { quickLinks } from '../lib/labels';
import { askAILinks, siteOrigin } from '../lib/markdown';

const items = await getItems();
const topics = topicCounts(items).filter(({ count }) => count >= 3);
const startHere = START_HERE.filter(({ slug }) => items.some((item) => item.slug === slug));
const demoCount = items.filter((item) => item.interactive).length;
const resourceCount = items.reduce((sum, item) => sum + item.resources.length, 0);

// The index only needs the links its cards show
const indexItems = items.map((item) => ({ ...item, resources: quickLinks(item.resources) }));

const origin = siteOrigin(Astro.site);
const askLinks = askAILinks(
  `Read ${origin}/llms-full.txt. It's AIpedia, the AI Encyclopedia: time-tested papers, software, interviews, ` +
    'positions, demos, and blogs worth knowing on the way into the singularity. Use it as a map: ask what I ' +
    'already know, then suggest where I should start.'
);
---

<Base>
  <div class="max-w-7xl mx-auto px-5">
    <section class="pt-16 pb-14 sm:pt-24 sm:pb-16">
      <h1 class="text-4xl sm:text-5xl font-semibold tracking-tight leading-[1.08]">
        The AI Encyclopedia
      </h1>
      <p class="mt-5 max-w-xl text-text-secondary leading-relaxed">
        The things worth knowing on the way into the singularity. A growing collection of time-tested cool
        things in AI: papers, software, interviews, positions, demos, and blogs, each explained with an
        interactive demo and linked to the originals.
      </p>
      <p class="mt-6 flex flex-wrap gap-x-6 gap-y-1 font-mono text-xs text-text-secondary">
        <span><span class="text-text">{items.length}</span> entries</span>
        <span><span class="text-text">{demoCount}</span> interactive demos</span>
        <span><span class="text-text">{resourceCount}</span> resources</span>
      </p>
      <p class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-[13px] text-text-secondary">
        <span>Share it with your AI:</span>
        <a href="/llms.txt" class="font-mono text-xs text-text underline-offset-4 hover:underline">llms.txt</a>
        <a href="/llms-full.txt" class="font-mono text-xs text-text underline-offset-4 hover:underline">llms-full.txt</a>
        {askLinks.map(({ label, href }) => (
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-0.5 transition-colors hover:text-text"
          >
            {label}<ArrowUpRight />
          </a>
        ))}
      </p>
    </section>

    <section class="mb-14" aria-labelledby="start-here">
      <div class="flex items-baseline justify-between gap-4 mb-4">
        <h2 id="start-here" class="font-mono text-[11px] uppercase tracking-[0.08em] text-text-secondary">
          Start here
        </h2>
        <p class="hidden sm:block text-[13px] text-text-secondary">From gradients to policies, in eight steps.</p>
      </div>
      <ol class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 border-t border-l border-border">
        {startHere.map(({ slug, label }, i) => (
          <li class="border-b border-r border-border">
            <a href={`/${slug}`} class="group flex h-full flex-col gap-3 p-3 sm:gap-5 sm:p-3.5 transition-colors hover:bg-bg-secondary">
              <span class="font-mono text-[11px] text-text-secondary tabular-nums">{String(i + 1).padStart(2, '0')}</span>
              <span class="text-[14px] leading-snug underline-offset-4 group-hover:underline">{label}</span>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <EntryIndex client:load items={indexItems} topics={topics} />
  </div>
</Base>
