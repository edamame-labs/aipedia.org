---
import Base from '../layouts/Base.astro';
---

<Base title="Not found">
  <div class="max-w-7xl mx-auto px-5 pt-24 sm:pt-32">
    <p class="font-mono text-[11px] uppercase tracking-[0.08em] text-text-secondary">404</p>
    <h1 class="mt-3 text-3xl sm:text-4xl font-semibold tracking-tight">This page isn't in the index.</h1>
    <p class="mt-3 text-text-secondary">
      It may have moved or never existed.
      <a href="/" class="text-text underline underline-offset-4">Browse all entries</a>
    </p>
  </div>
</Base>
